{
  "name": "acme-corp",
  "displayName": "Acme Corp",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "turbo typecheck && tsc --noEmit",
    "test": "turbo test",
    "test:e2e": "playwright test",
    "knip": "knip",
    "rename": "bun scripts/rename.ts",
    "check": "bun run lint && bun run typecheck && bun run test && bun run build && bun run knip",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:generate": "bun --filter @acme-corp/db db:generate",
    "db:migrate": "bun --filter @acme-corp/db db:migrate",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "knip": "6.41.0",
    "lefthook": "2.2.2",
    "turbo": "2.11.8",
    "typescript": "7.0.2"
  },
  "trustedDependencies": [
    "esbuild",
    "lefthook"
  ]
}
